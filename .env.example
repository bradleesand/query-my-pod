# Episode Processing Configuration

# Enable automatic transcription when new episodes are imported
# Default: false (manual trigger required)
AUTO_TRANSCRIBE=false

# Enable transcription feature globally
# Default: true
ENABLE_TRANSCRIPTION=true

# Enable automatic audio download when new episodes are imported
# Default: false (manual trigger required)
AUTO_DOWNLOAD_AUDIO=false

# Enable downloading audio files to local storage during transcription
# When true: downloads to storage/episodes/{podcast_id}/{episode_id}.{ext}
# When false: downloads to temporary file only for transcription
# Default: false
DOWNLOAD_AUDIO=true

# Ad Detection Configuration

# Enable ad detection feature
# Default: true
ENABLE_AD_DETECTION=true

# RAG Search Configuration

# Enable semantic search feature (requires Python dependencies)
# Default: false
ENABLE_SEMANTIC_SEARCH=true

# Python path for embedding generation
# Default: venv/bin/python3 (uses project virtual environment)
PYTHON_PATH=venv/bin/python3

# Ollama API endpoint
# Default: http://localhost:11434
OLLAMA_API_URL=http://localhost:11434

# Ollama model name (e.g., qwen2.5:7b, llama3.2, gemma3:12b, mistral)
# Recommended: qwen2.5:7b (best quality) or llama3.2 (faster)
# Default: qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b

# Number of chunks to retrieve for search context
# Default: 10
SEARCH_CONTEXT_CHUNKS=10
