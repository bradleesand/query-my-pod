<% content_for :title, "Search Results" %>

<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <h1 class="mb-4">Search Results</h1>

      <div class="card mb-4">
        <div class="card-body">
          <h5 class="card-title">Query: <%= @query %></h5>
          <% if @podcast_id %>
            <p class="text-muted">Searching in: <%= Podcast.find(@podcast_id).title %></p>
          <% elsif @episode_id %>
            <% episode = Episode.find(@episode_id) %>
            <p class="text-muted">Searching in: <%= episode.title %> (<%= episode.podcast.title %>)</p>
          <% else %>
            <p class="text-muted">Searching across all podcasts</p>
          <% end %>
        </div>
      </div>

      <% if @error %>
        <div class="alert alert-danger"><%= @error %></div>
      <% elsif @llm_response %>
        <div class="card mb-4">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0">AI Response</h5>
          </div>
          <div class="card-body">
            <%= simple_format(@llm_response[:response], class: "mb-0") %>
          </div>
        </div>

        <h4 class="mt-4 mb-3">Sources</h4>
        <% @llm_response[:sources].each do |source| %>
          <div class="card mb-3">
            <div class="card-body">
              <h6 class="card-subtitle mb-2 text-muted">[<%= source[:index] %>]</h6>
              <h5 class="card-title">
                <%= link_to source[:episode_title], episode_path(source[:episode]) %>
              </h5>
              <p class="text-muted mb-2">
                <%= link_to source[:podcast_title], podcast_path(source[:podcast]), class: "text-decoration-none" %> • <%= source[:timestamp] %>
              </p>
              <p class="card-text"><%= source[:text] %></p>
              <small class="text-muted">Similarity: <%= number_to_percentage((1 - source[:distance]) * 100, precision: 1) %></small>
            </div>
          </div>
        <% end %>
      <% end %>

      <%= link_to "New Search", :back, class: "btn btn-secondary mt-3" %>
    </div>
  </div>
</div>