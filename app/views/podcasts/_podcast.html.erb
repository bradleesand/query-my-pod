<div id="<%= dom_id podcast %>">
  <p>
    <strong>Rss url:</strong>
    <%= podcast.rss_url %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= podcast.title %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= podcast.description %>
  </p>

  <p>
    <strong>Link:</strong>
    <%= podcast.link %>
  </p>

  <p>
    <strong>Language:</strong>
    <%= podcast.language %>
