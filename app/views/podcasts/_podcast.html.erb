  <p>
    <strong>Image url:</strong>
    <%= podcast.image_url %>
  </p>

  <p>
    <strong>Guid:</strong>
    <%= podcast.guid %>
  </p>

  <p>
    <strong>Author:</strong>
    <%= podcast.author %>
