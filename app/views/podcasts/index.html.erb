<% content_for :title, "Podcasts" %>

<%= turbo_stream_from "podcast_imports" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Podcasts</h1>
  <%= turbo_frame_tag "new_podcast_import" do %>
    <%= link_to "Import New Podcast", new_podcast_import_task_path, class: "btn btn-primary", data: { turbo_frame: "new_podcast_import" } %>
  <% end %>
</div>

<%= turbo_frame_tag "new_podcast_import" %>

<%= render "search/search_form", placeholder: "Search across all podcasts..." %>

<% if @pending_imports.any? %>
  <div class="mb-4">
    <h5>Active Imports</h5>
    <div id="pending_imports">
      <% @pending_imports.each do |import_task| %>
        <%= render "podcast_import_tasks/import_task", import_task: import_task %>
      <% end %>
    </div>
  </div>
<% end %>

<div id="podcasts">
  <ul class="list-group">
    <% @podcasts.each do |podcast| %>
      <li class="list-group-item">
        <%= link_to podcast.title, podcast, class: "text-decoration-none" %>
      </li>
    <% end %>
  </ul>
</div>
