<% content_for :title, @episode.title %>

<div class="row">
  <div class="col-md-3">
    <% if @episode.image_url.present? %>
      <%= image_tag @episode.image_url, alt: @episode.title, class: "img-fluid rounded shadow-sm mb-3" %>
    <% elsif @episode.podcast.image_url.present? %>
      <%= image_tag @episode.podcast.image_url, alt: @episode.title, class: "img-fluid rounded shadow-sm mb-3" %>
    <% end %>
    
    <div class="card mb-3">
      <div class="card-body">
        <dl class="mb-0">
          <% if @episode.pub_date.present? %>
            <dt class="small text-muted">Published</dt>
            <dd class="mb-2"><%= @episode.pub_date.strftime("%B %d, %Y") %></dd>
          <% end %>
          
          <% if @episode.duration.present? %>
            <dt class="small text-muted">Duration</dt>
            <dd class="mb-2"><%= Time.at(@episode.duration).utc.strftime("%H:%M:%S").sub(/^00:/, '') %></dd>
          <% end %>
          
          <% if @episode.season_number.present? && @episode.season_number > 0 %>
            <dt class="small text-muted">Season</dt>
            <dd class="mb-2"><%= @episode.season_number %></dd>
          <% end %>
          
          <% if @episode.episode_number.present? && @episode.episode_number > 0 %>
            <dt class="small text-muted">Episode</dt>
            <dd class="mb-2"><%= @episode.episode_number %></dd>
          <% end %>
          
          <% if @episode.explicit.present? %>
            <dt class="small text-muted">Explicit</dt>
            <dd class="mb-0"><%= @episode.explicit ? "Yes" : "No" %></dd>
          <% end %>
        </dl>
      </div>
    </div>

    <%= turbo_stream_from "episode_#{@episode.id}_status" %>
    
    <%= render "episodes/status", episode: @episode %>
    
    <div class="card">
      <div class="card-body">
        <h6 class="card-subtitle mb-2 text-muted">Links</h6>
        <ul class="list-unstyled mb-0">
          <% if @episode.link.present? %>
            <li class="mb-2">
              <%= link_to @episode.link, target: "_blank", rel: "noopener", class: "text-decoration-none" do %>
                <i class="bi bi-link-45deg"></i> Episode Page
              <% end %>
            </li>
          <% end %>
          
          <% if @episode.transcript_url.present? %>
            <li class="mb-2">
              <%= link_to @episode.transcript_url, target: "_blank", rel: "noopener", class: "text-decoration-none" do %>
                <i class="bi bi-file-text"></i> Transcript
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
  
  <div class="col-md-9">
    <h1 class="mb-3"><%= @episode.title %></h1>
    
    <p class="text-muted">
      <%= link_to @episode.podcast.title, @episode.podcast, class: "text-decoration-none" %>
    </p>

    <%= render "search/search_form", episode_id: @episode.id, placeholder: "Search in this episode..." %>

    <% if @episode.description.present? %>
      <div class="card mb-4">
        <div class="card-body">
          <h6 class="card-subtitle mb-2 text-muted">Description</h6>
          <div class="episode-description">
            <%= sanitize @episode.description, tags: %w[p ol ul li a b i strong em], attributes: %w[href] %>
          </div>
        </div>
      </div>
    <% end %>

    <% if @episode.enclosure_url.present? %>
      <div class="card mb-4">
        <div class="card-body">
          <h6 class="card-subtitle mb-3 text-muted">Audio Player</h6>
          <audio controls class="w-100" preload="metadata">
            <source src="<%= @episode.audio_url %>" type="<%= @episode.enclosure_type || 'audio/mpeg' %>">
            Your browser does not support the audio element.
          </audio>
        </div>
      </div>
    <% end %>

    <% if @episode.transcription_completed? && @episode.transcript_chunks.any? %>
      <div class="card mb-4">
        <div class="card-body">
          <h6 class="card-subtitle mb-2 text-muted">Generated Transcript</h6>
          <div class="transcript-text"
               id="transcript-container"
               data-controller="transcript-highlight"
               style="max-height: 400px; overflow-y: auto;">
            <% @episode.transcript_chunks.order(:start_time).each do |chunk| %>
              <span class="transcript-chunk"
                    id="chunk-<%= chunk.id %>"
                    data-chunk-id="<%= chunk.id %>"
                    data-start-time="<%= chunk.start_time %>"
                    data-end-time="<%= chunk.end_time %>"><%= chunk.text %></span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-4">
  <%= link_to "Back to #{@episode.podcast.title}", @episode.podcast, class: "btn btn-secondary" %>
</div>
