  </div>

  <div>
    <%= form.label :transcript_url, style: "display: block" %>
    <%= form.textarea :transcript_url %>
  </div>

  <div>
    <%= form.label :transcript_type, style: "display: block" %>
    <%= form.textarea :transcript_type %>
  </div>

  <div>
    <%= form.label :episode_number, style: "display: block" %>
    <%= form.number_field :episode_number %>
  </div>

  <div>
    <%= form.label :season_number, style: "display: block" %>
    <%= form.number_field :season_number %>
  </div>

  <div>
    <%= form.label :episode_type, style: "display: block" %>
    <%= form.textarea :episode_type %>
  </div>

  <div>
    <%= form.label :block, style: "display: block" %>
    <%= form.checkbox :block %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
